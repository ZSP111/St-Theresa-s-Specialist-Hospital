# Server
PORT=4000
# Public URL of this backend (used for locally stored images). Optional.
# BACKEND_URL=http://localhost:4000
# URL of the patient website (used as the Paystack payment redirect)
FRONTEND_URL=http://localhost:5173

# MongoDB (MongoDB Atlas connection string, without a database name)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=st-theresas-hospital

# Authentication - use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# Admin panel login
ADMIN_EMAIL=admin@sttheresas.com
ADMIN_PASSWORD=change-me

# Cloudinary (optional - if empty, images are stored in backend/uploads)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Paystack online payments (optional - get keys at https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=
CURRENCY=NGN

# Password given to sample doctors created by `npm run seed`
SEED_DOCTOR_PASSWORD=Doctor@12345
